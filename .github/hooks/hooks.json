{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash .github/hooks/format-go.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash .github/hooks/verify-go.sh",
        "timeout": 120
      }
    ]
  }
}
